<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_DiLucca" targetNamespace="https://di-lucca.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:collaboration id="Collaboration_Core" name="Di Lucca - Atención integral del paciente">
    <bpmn:participant id="Participant_Paciente" name="Paciente" />
    <bpmn:participant id="Participant_Secretaria" name="Secretaría / Asistencia / Administrador" processRef="Process_Secretaria" />
    <bpmn:participant id="Participant_Patients" name="Patients | Gestión de pacientes" processRef="Process_Patients" />
    <bpmn:participant id="Participant_Appointments" name="Appointments | Gestión de citas" processRef="Process_Appointments" />
    <bpmn:participant id="Participant_Odontologo" name="Odontólogo" processRef="Process_Odontologo" />
    <bpmn:participant id="Participant_Clinical" name="Clinical | Gestión de la atención clínica" processRef="Process_Clinical" />
    <bpmn:participant id="Participant_Billing" name="Billing | Facturación y pagos" processRef="Process_Billing" />
    <bpmn:participant id="Participant_Worker" name="Worker | Envío de correos" processRef="Process_Worker" />
    <bpmn:messageFlow id="Message_91" name="Solicitud de cita" sourceRef="Participant_Paciente" targetRef="Solicitud" />
    <bpmn:messageFlow id="Message_92" name="Llamada o aviso externo" sourceRef="Participant_Paciente" targetRef="Llamada" />
    <bpmn:messageFlow id="Message_93" name="Búsqueda / registro" sourceRef="BuscarPaciente" targetRef="ConsultaPaciente" />
    <bpmn:messageFlow id="Message_94" name="Paciente disponible" sourceRef="PacienteDisponible" targetRef="ElegirHorario" />
    <bpmn:messageFlow id="Message_95" name="Agendar cita" sourceRef="SolicitarReserva" targetRef="ReservarInicio" />
    <bpmn:messageFlow id="Message_96" name="Cancelar por solicitud del paciente" sourceRef="PedirCancelacion" targetRef="CancelarInicio" />
    <bpmn:messageFlow id="Message_97" name="Reprogramar cita" sourceRef="PedirCambio" targetRef="MoverInicio" />
    <bpmn:messageFlow id="Message_98" name="Asistencia o inasistencia" sourceRef="ComprobarAsistencia" targetRef="AsistenciaInicio" />
    <bpmn:messageFlow id="Message_99" name="Finalizar cita" sourceRef="CerrarCita" targetRef="FinalizarInicio" />
    <bpmn:messageFlow id="Message_100" name="Iniciar atención" sourceRef="CitaAtendida" targetRef="AtencionInicio" />
    <bpmn:messageFlow id="Message_101" name="Consultar historia" sourceRef="RevisarHistoria" targetRef="HistoriaInicio" />
    <bpmn:messageFlow id="Message_102" name="Historia clínica" sourceRef="HistoriaEntregada" targetRef="RevisarHistoria" />
    <bpmn:messageFlow id="Message_104" name="Procedimiento realizado" sourceRef="RealizarProcedimiento" targetRef="RegistroClinico" />
    <bpmn:messageFlow id="Message_105" name="Cerrar atención" sourceRef="TerminarAtencion" targetRef="CierreClinico" />
    <bpmn:messageFlow id="Message_106" name="Atención clínica terminada" sourceRef="ClinicaTerminada" targetRef="ListaParaCerrar" />
    <bpmn:messageFlow id="Message_107" name="Procedimiento completado" sourceRef="ProcedimientoGuardado" targetRef="CargosInicio" />
    <bpmn:messageFlow id="Message_108" name="Cita finalizada" sourceRef="CitaFinalizada" targetRef="EsperarCierre" />
    <bpmn:messageFlow id="Message_109" name="Cargos listos para revisión" sourceRef="AvisarCargos" targetRef="CobroListo" />
    <bpmn:messageFlow id="Message_110" name="Emitir factura" sourceRef="EmitirFactura" targetRef="OrdenFactura" />
    <bpmn:messageFlow id="Message_111" name="Aplicar pago" sourceRef="IngresoPago" targetRef="PagoInicio" />
    <bpmn:messageFlow id="Message_112" name="Recordatorio de la cita" sourceRef="SolicitarRecordatorio" targetRef="CorreoInicio" />
    <bpmn:messageFlow id="Message_113" name="Aviso de cancelación" sourceRef="CorreoCancelacion" targetRef="CorreoInicio" />
    <bpmn:messageFlow id="Message_114" name="Aviso de reprogramación" sourceRef="CorreoCambio" targetRef="CorreoInicio" />
    <bpmn:messageFlow id="Message_115" name="Factura y PDF" sourceRef="FacturaEmitida" targetRef="CorreoInicio" />
    <bpmn:messageFlow id="Message_116" name="Pago y saldo actualizado" sourceRef="AvisarPago" targetRef="CorreoInicio" />
    <bpmn:messageFlow id="Message_117" name="Correo informativo" sourceRef="EnviarCorreo" targetRef="Participant_Paciente" />
    <bpmn:messageFlow id="Message_103" name="Diagnóstico y plan" sourceRef="Diagnosticar" targetRef="RegistroClinico" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Secretaria" name="Secretaría / Asistencia / Administrador" isExecutable="false">
    <bpmn:userTask id="ElegirHorario" name="Seleccionar odontólogo, fecha y hora disponibles">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="SolicitarReserva" name="Solicitar el registro de la cita">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="DiaCita" name="Fecha y hora de la cita">
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="DiaCita_definition" />
    </bpmn:startEvent>
    <bpmn:userTask id="ComprobarAsistencia" name="Comprobar la presencia del paciente y registrar asistencia o inasistencia">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="ListaParaCerrar" name="Atención clínica terminada">
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ListaParaCerrar_definition" />
    </bpmn:startEvent>
    <bpmn:userTask id="RevisarSolicitud" name="Identificar la cita y atender la solicitud del paciente">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="CambioCancelacion" name="Cancelación solicitada">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Llamada" name="Llamada o aviso externo del paciente">
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Llamada_definition" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Solicitud" name="Solicitud de cita recibida">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Solicitud_definition" />
    </bpmn:startEvent>
    <bpmn:userTask id="BuscarPaciente" name="Buscar al paciente o registrar sus datos">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="AsistenciaEnviada" name="Asistencia registrada">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="SolicitudEnviada" name="Solicitud registrada">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="PagoEnviado" name="Pago registrado">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="IngresoPago" name="Registrar el valor del pago recibido">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="RecibePago" name="¿Se recibe un pago?">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="PagoPendiente" name="Factura pendiente de pago">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="EmitirFactura" name="Revisar los cargos y solicitar la factura">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="CobroListo" name="Cargos listos para facturar">
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="CobroListo_definition" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="TipoCambio" name="¿Qué solicita?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_1biswdd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="PedirCancelacion" name="Registrar la cancelación de la cita en el sistema">
      <bpmn:incoming>Flow_1biswdd</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PedirCambio" name="Acordar nuevo horario y registrar la reprogramación">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="CambioHorario" name="Reprogramación solicitada">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="CerrarCita" name="Revisar y finalizar la cita atendida">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="CierreSolicitado" name="Finalización solicitada">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="BuscarPaciente" targetRef="ElegirHorario" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="ElegirHorario" targetRef="SolicitarReserva" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="SolicitarReserva" targetRef="SolicitudEnviada" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="DiaCita" targetRef="ComprobarAsistencia" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="ComprobarAsistencia" targetRef="AsistenciaEnviada" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="ListaParaCerrar" targetRef="CerrarCita" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Llamada" targetRef="RevisarSolicitud" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="RevisarSolicitud" targetRef="TipoCambio" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="PedirCancelacion" targetRef="CambioCancelacion" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Solicitud" targetRef="BuscarPaciente" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="IngresoPago" targetRef="PagoEnviado" />
    <bpmn:sequenceFlow id="Flow_17" name="Sí" sourceRef="RecibePago" targetRef="IngresoPago" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="EmitirFactura" targetRef="RecibePago" />
    <bpmn:sequenceFlow id="Flow_19" name="No" sourceRef="RecibePago" targetRef="PagoPendiente" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="CobroListo" targetRef="EmitirFactura" />
    <bpmn:sequenceFlow id="Flow_9" name="Reprogramar" sourceRef="TipoCambio" targetRef="PedirCambio" />
    <bpmn:sequenceFlow id="Flow_1biswdd" name="Cancelar" sourceRef="TipoCambio" targetRef="PedirCancelacion" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="PedirCambio" targetRef="CambioHorario" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="CerrarCita" targetRef="CierreSolicitado" />
  </bpmn:process>
  <bpmn:process id="Process_Patients" name="Patients | Gestión de pacientes" isExecutable="false">
    <bpmn:endEvent id="PacienteDisponible" name="Paciente disponible">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:messageEventDefinition id="PacienteDisponible_definition" />
    </bpmn:endEvent>
    <bpmn:startEvent id="ConsultaPaciente" name="Solicitud de búsqueda o registro">
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ConsultaPaciente_definition" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="IdentificarPaciente" name="Buscar y validar los datos del paciente">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CrearPaciente" name="Guardar el nuevo paciente">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExistePaciente" name="¿Existe?">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="CrearPaciente" targetRef="PacienteDisponible" />
    <bpmn:sequenceFlow id="Flow_24" name="Sí" sourceRef="ExistePaciente" targetRef="PacienteDisponible" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="ConsultaPaciente" targetRef="IdentificarPaciente" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="IdentificarPaciente" targetRef="ExistePaciente" />
    <bpmn:sequenceFlow id="Flow_22" name="No" sourceRef="ExistePaciente" targetRef="CrearPaciente" />
  </bpmn:process>
  <bpmn:process id="Process_Appointments" name="Appointments | Gestión de citas" isExecutable="false">
    <bpmn:serviceTask id="ValidarReserva" name="Validar permisos, paciente, odontólogo y disponibilidad del horario">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="GuardarCita" name="Reservar el horario y guardar la cita sin permitir solapamientos">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ReservaValida" name="¿Reserva realizada?">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="ReservaParalela" name="">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="CitaAgendada" name="Cita agendada">
      <bpmn:incoming>Flow_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ProgramarAviso" name="Programar el recordatorio para 24 horas antes">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="AvisoProgramado" name="Recordatorio programado">
      <bpmn:incoming>Flow_31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="RecordatorioVigente" name="¿Sigue vigente?">
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="SolicitarRecordatorio" name="Solicitar correo de recordatorio de la cita">
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="OmitirAviso" name="Omitir recordatorio anterior">
      <bpmn:incoming>Flow_37</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="CambioValido" name="¿Cambio realizado?">
      <bpmn:incoming>Flow_44</bpmn:incoming>
      <bpmn:outgoing>Flow_45</bpmn:outgoing>
      <bpmn:outgoing>Flow_50</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CambioRechazado" name="Informar conflicto; elegir otro horario">
      <bpmn:incoming>Flow_50</bpmn:incoming>
      <bpmn:messageEventDefinition id="CambioRechazado_definition" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="CorreoCambio" name="Solicitar correo con la nueva fecha y hora">
      <bpmn:incoming>Flow_48</bpmn:incoming>
      <bpmn:outgoing>Flow_49</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Asistio" name="¿Asistió?">
      <bpmn:incoming>Flow_51</bpmn:incoming>
      <bpmn:outgoing>Flow_52</bpmn:outgoing>
      <bpmn:outgoing>Flow_54</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="GuardarInasistencia" name="Guardar inasistencia y liberar horario">
      <bpmn:incoming>Flow_54</bpmn:incoming>
      <bpmn:outgoing>Flow_55</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="FinalizarInicio" name="Finalización solicitada por secretaría">
      <bpmn:outgoing>Flow_56</bpmn:outgoing>
      <bpmn:messageEventDefinition id="FinalizarInicio_definition" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="FinalizarCita" name="Validar atención terminada y guardar finalización de la cita">
      <bpmn:incoming>Flow_56</bpmn:incoming>
      <bpmn:outgoing>Flow_57</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CitaFinalizada" name="Cita finalizada">
      <bpmn:incoming>Flow_57</bpmn:incoming>
      <bpmn:messageEventDefinition id="CitaFinalizada_definition" />
    </bpmn:endEvent>
    <bpmn:startEvent id="ReservarInicio" name="Solicitud de agendamiento">
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ReservarInicio_definition" />
    </bpmn:startEvent>
    <bpmn:endEvent id="ReservaRechazada" name="Informar conflicto; elegir otro horario">
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:messageEventDefinition id="ReservaRechazada_definition" />
    </bpmn:endEvent>
    <bpmn:startEvent id="CancelarInicio" name="Cancelación registrada por secretaría">
      <bpmn:outgoing>Flow_1kvaodc</bpmn:outgoing>
      <bpmn:messageEventDefinition id="CancelarInicio_definition" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="CancelarCita" name="Validar permisos y estado; guardar cancelación, liberar horario y anular recordatorio">
      <bpmn:incoming>Flow_1kvaodc</bpmn:incoming>
      <bpmn:outgoing>Flow_39</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="CancelacionParalela" name="">
      <bpmn:incoming>Flow_39</bpmn:incoming>
      <bpmn:outgoing>Flow_40</bpmn:outgoing>
      <bpmn:outgoing>Flow_41</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="Cancelada" name="Cita cancelada">
      <bpmn:incoming>Flow_40</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="CorreoCancelacion" name="Solicitar correo de cancelación">
      <bpmn:incoming>Flow_41</bpmn:incoming>
      <bpmn:outgoing>Flow_0mcxwcs</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CancelacionNotificada" name="Aviso solicitado">
      <bpmn:incoming>Flow_0mcxwcs</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="CambioNotificado" name="Aviso solicitado">
      <bpmn:incoming>Flow_49</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="MoverCita" name="Validar y reservar nuevo horario; liberar anterior y guardar reprogramación">
      <bpmn:incoming>Flow_43</bpmn:incoming>
      <bpmn:outgoing>Flow_44</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="MoverInicio" name="Reprogramación registrada por secretaría">
      <bpmn:outgoing>Flow_43</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MoverInicio_definition" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="CambiarRecordatorio" name="Anular recordatorio anterior y programar el nuevo">
      <bpmn:incoming>Flow_45</bpmn:incoming>
      <bpmn:outgoing>Flow_46</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="CambioParalelo" name="">
      <bpmn:incoming>Flow_46</bpmn:incoming>
      <bpmn:outgoing>Flow_47</bpmn:outgoing>
      <bpmn:outgoing>Flow_48</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="Reprogramada" name="Cita reprogramada">
      <bpmn:incoming>Flow_47</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ValidarRecordatorio" name="Verificar que la cita siga vigente y el horario no haya cambiado">
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="RecordatorioHora" name="24 horas antes de la cita">
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
      <bpmn:timerEventDefinition id="RecordatorioHora_definition" />
    </bpmn:startEvent>
    <bpmn:endEvent id="RecordatorioPedido" name="Recordatorio solicitado">
      <bpmn:incoming>Flow_36</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="CitaAtendida" name="Paciente listo para atención">
      <bpmn:incoming>Flow_53</bpmn:incoming>
      <bpmn:messageEventDefinition id="CitaAtendida_definition" />
    </bpmn:endEvent>
